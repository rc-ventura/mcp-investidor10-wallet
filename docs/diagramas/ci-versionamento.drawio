<mxfile host="app.diagrams.net"><diagram id="ci-versionamento" name="CI do versionamento"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="CI do versionamento: da preparação em develop até main" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="800" height="30" as="geometry"/></mxCell><mxCell id="lane1" value="1 · Preparação em develop (ci.yml)" style="swimlane;startSize=26;html=1;fontSize=14;fillColor=#F7F8FA;strokeColor=#D5DAE1;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="1100" height="130" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b&gt;Pedido de revisão&lt;/b&gt;&lt;br&gt;&lt;small&gt;versão nos 6 lugares + CHANGELOG&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FFF0E5;strokeColor=#F0B48A;fontColor=#1B1F24;" vertex="1" parent="lane1"><mxGeometry x="20" y="40" width="160" height="72" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b&gt;ci.yml&lt;/b&gt;&lt;br&gt;&lt;small&gt;test 3 SO × 3 Pythons · plugin validate · audit&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="lane1"><mxGeometry x="200" y="40" width="160" height="72" as="geometry"/></mxCell><mxCell id="a3" value="&lt;b&gt;Merge em develop&lt;/b&gt;&lt;br&gt;&lt;small&gt;mantenedor&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FFF0E5;strokeColor=#F0B48A;fontColor=#1B1F24;" vertex="1" parent="lane1"><mxGeometry x="380" y="40" width="160" height="72" as="geometry"/></mxCell><mxCell id="n1" value="Pré-lançamento (rcN) segue o mesmo caminho até o verify e para aí: nunca vai para main." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFF9DB;strokeColor=#E9D58A;fontColor=#1B1F24;" vertex="1" parent="lane1"><mxGeometry x="580" y="46" width="480" height="60" as="geometry"/></mxCell><mxCell id="lane2" value="2 · Tag e publicação (release.yml)" style="swimlane;startSize=26;html=1;fontSize=14;fillColor=#F7F8FA;strokeColor=#D5DAE1;" vertex="1" parent="1"><mxGeometry x="20" y="190" width="1100" height="130" as="geometry"/></mxCell><mxCell id="n2" value="Falhou antes do publish: apagar a tag e refazer. Depois do publish o número não se reutiliza: subir a versão." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFF9DB;strokeColor=#E9D58A;fontColor=#1B1F24;" vertex="1" parent="lane2"><mxGeometry x="20" y="46" width="340" height="60" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;Tag vX.Y.Z / vX.Y.ZrcN&lt;/b&gt;&lt;br&gt;&lt;small&gt;em develop · mantenedor&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FFF0E5;strokeColor=#F0B48A;fontColor=#1B1F24;" vertex="1" parent="lane2"><mxGeometry x="380" y="40" width="160" height="72" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;build&lt;/b&gt;&lt;br&gt;&lt;small&gt;tag = versão = changelog · uv build · smoke&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="lane2"><mxGeometry x="560" y="40" width="160" height="72" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;publish&lt;/b&gt;&lt;br&gt;&lt;small&gt;ambiente pypi · aprovação manual · PyPI&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="lane2"><mxGeometry x="740" y="40" width="160" height="72" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;verify&lt;/b&gt;&lt;br&gt;&lt;small&gt;pip + uvx da versão exata · 3 SO&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="lane2"><mxGeometry x="920" y="40" width="160" height="72" as="geometry"/></mxCell><mxCell id="lane3" value="3 · Promoção para main (só versão final · promote.yml e main-gate.yml)" style="swimlane;startSize=26;html=1;fontSize=14;fillColor=#F7F8FA;strokeColor=#D5DAE1;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="1100" height="250" as="geometry"/></mxCell><mxCell id="n3" value="Primeira promoção (0.4.0): à mão, com plan_promotion.py --apply, porque o promote.yml ainda não está em main." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFF9DB;strokeColor=#E9D58A;fontColor=#1B1F24;" vertex="1" parent="lane3"><mxGeometry x="20" y="46" width="340" height="60" as="geometry"/></mxCell><mxCell id="n4" value="Hotfix: o promote.yml também abre o pedido da tag para develop." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFF9DB;strokeColor=#E9D58A;fontColor=#1B1F24;" vertex="1" parent="lane3"><mxGeometry x="380" y="46" width="320" height="60" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Fim&lt;/b&gt;&lt;br&gt;&lt;small&gt;pré-lançamento nunca chega a main&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FDECEC;strokeColor=#EBA3A3;fontColor=#1B1F24;" vertex="1" parent="lane3"><mxGeometry x="740" y="44" width="160" height="72" as="geometry"/></mxCell><mxCell id="c1" value="Tag tem rc?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FFF6E0;strokeColor=#E8C36A;fontColor=#1B1F24;" vertex="1" parent="lane3"><mxGeometry x="920" y="36" width="160" height="88" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;promote.yml&lt;/b&gt;&lt;br&gt;&lt;small&gt;plan_promotion.py --sha · só cria e abre, sem merge&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="lane3"><mxGeometry x="920" y="150" width="160" height="72" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;promote/vX.Y.Z&lt;/b&gt;&lt;br&gt;&lt;small&gt;branch no commit da tag + pedido para main&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="lane3"><mxGeometry x="740" y="150" width="160" height="72" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;main-gate + CI&lt;/b&gt;&lt;br&gt;&lt;small&gt;origem promote/v*, commit = tag, versão no PyPI&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="lane3"><mxGeometry x="560" y="150" width="160" height="72" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Merge em main&lt;/b&gt;&lt;br&gt;&lt;small&gt;mantenedor aprova os runs e faz o merge&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FFF0E5;strokeColor=#F0B48A;fontColor=#1B1F24;" vertex="1" parent="lane3"><mxGeometry x="380" y="150" width="160" height="72" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;main = marketplace&lt;/b&gt;&lt;br&gt;&lt;small&gt;o usuário recebe a versão nova&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#E7F6EC;strokeColor=#8BCB9F;fontColor=#1B1F24;" vertex="1" parent="lane3"><mxGeometry x="200" y="150" width="160" height="72" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;" edge="1" parent="lane1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;" edge="1" parent="lane1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;" edge="1" parent="1" source="a3" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;" edge="1" parent="lane2" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;" edge="1" parent="lane2" source="b2" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;" edge="1" parent="lane2" source="b3" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;" edge="1" parent="1" source="b4" target="c1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#C9302C;" edge="1" parent="lane3" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#1E7F3E;" edge="1" parent="lane3" source="c1" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;" edge="1" parent="lane3" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;" edge="1" parent="lane3" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;" edge="1" parent="lane3" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;" edge="1" parent="lane3" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l1" value="Automático (workflow)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="20" y="596" width="170" height="28" as="geometry"/></mxCell><mxCell id="l2" value="Ação do mantenedor" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFF0E5;strokeColor=#F0B48A;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="210" y="596" width="170" height="28" as="geometry"/></mxCell><mxCell id="l3" value="Resultado final" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#E7F6EC;strokeColor=#8BCB9F;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="400" y="596" width="170" height="28" as="geometry"/></mxCell><mxCell id="l4" value="Fim sem promoção" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FDECEC;strokeColor=#EBA3A3;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="590" y="596" width="170" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
